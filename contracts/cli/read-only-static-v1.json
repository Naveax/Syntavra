      }
    },
    {
      "route": "plugins.list",
      "cli_argv": ["plugins", "list"],
      "rust_argv": ["plugins", "list"],
      "capability": "plugins.list",
      "result": {
        "discovery": "explicit-only",
        "plugins": []
