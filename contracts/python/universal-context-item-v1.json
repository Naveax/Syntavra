{
  "schema_version": 1,
  "family": "universal-context-item",
  "phase": "python-first",
  "claim": "UNIVERSAL_CONTEXT_ITEM_V1",
  "strict": true,
  "runtime": "syntavra_runtime/universal_context_item.py",
  "canonical_type": "UniversalContextItem",
  "representation_vocabulary": [
    "exact",
    "structural",
    "semantic",
    "bounded-preview"
  ],
  "trust_level_vocabulary": [
    "unknown",
    "untrusted",
    "observed",
    "verified"
  ],
  "freshness_state_vocabulary": [
    "unknown",
    "fresh",
    "stale",
    "expired"
  ],
  "recovery_kind_vocabulary": [
    "file-range",
    "evidence-node",
    "evidence-edge",
    "artifact",
    "memory",
    "tool-result"
  ],
  "required_top_level_fields": [
    "schema_version",
    "item_id",
    "kind",
    "representation",
    "content",
    "content_sha256",
    "provenance",
    "trust",
    "freshness",
    "recovery",
    "metadata"
  ],
  "provenance_fields": [
    "source",
    "repository_commit",
    "observed_at",
    "parent_item_ids",
    "metadata"
  ],
  "trust_fields": [
    "level",
    "confidence",
    "taint",
    "reasons"
  ],
  "freshness_fields": [
    "state",
    "observed_at",
    "expires_at",
    "lease_id"
  ],
  "recovery_fields": [
    "kind",
    "locator",
    "integrity",
    "exact"
  ],
  "adapters": {
    "ContextPackItem": "UniversalContextItem.from_context_pack_item",
    "EvidenceNode": "UniversalContextItem.from_evidence_node",
    "EvidenceEdge": "UniversalContextItem.from_evidence_edge"
  },
  "compatibility": {
    "context_pack_serialization_unchanged": true,
    "runtime_evidence_serialization_unchanged": true,
    "adapter_is_additive": true,
    "no_duplicate_route_identity": true
  },
  "integrity": {
    "canonical_json": true,
    "content_sha256_required": true,
    "item_id_sha256_required": true,
    "roundtrip_must_reverify": true,
    "tamper_must_fail_closed": true,
    "recovery_handle_integrity_required": true
  },
  "policy": {
    "provenance_required": true,
    "trust_explicit": true,
    "taint_explicit": true,
    "freshness_explicit": true,
    "exact_recovery_handle_supported": true,
    "parent_lineage_supported": true,
    "trust_and_freshness_not_part_of_stable_identity": true,
    "content_and_provenance_part_of_stable_identity": true,
    "no_silent_fallback": true
  }
}
