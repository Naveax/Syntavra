{
  "schema_version": 1,
  "public_routes": [
    "provider capabilities",
    "provider capture",
    "provider prepare",
    "provider proxy",
    "provider replay",
    "provider stats",
    "provider verify",
    "run gateway-plan",
    "run provider-pool",
    "run provider-route",
    "run proxy-plan",
    "run proxy-service install",
    "run proxy-service plan",
    "run proxy-service uninstall",
    "run proxy-service verify"
  ],
  "provider_gateway": {
    "canonical_providers": [
      "anthropic",
      "gemini",
      "openai",
      "openai-compatible"
    ],
    "azure_openai_canonical": "openai",
    "unsupported_exit": 4,
    "credential_payload_exit": 4
  },
  "proxy_presets": [
    "anthropic",
    "aws-bedrock",
    "azure-openai",
    "cohere",
    "gemini",
    "groq",
    "mistral",
    "openai",
    "openrouter",
    "vertex-ai"
  ],
  "proxy_config": {
    "fields": [
      "provider",
      "upstream_base",
      "listen_host",
      "listen_port",
      "credential_env",
      "credential_header",
      "credential_prefix",
      "control_token_env",
      "allow_remote",
      "allow_insecure_upstream",
      "tls_cert_file",
      "tls_key_file",
      "cache_policy",
      "replay_ttl_seconds",
      "prompt_cache_ttl_seconds",
      "timeout_seconds",
      "max_request_bytes",
      "max_buffered_response_bytes",
      "spool_memory_bytes",
      "default_anthropic_version",
      "stream_mode",
      "max_concurrent_requests",
      "drain_timeout_seconds",
      "block_secret_outputs",
      "block_prompt_injection_outputs"
    ],
    "defaults": {
      "listen_host": "127.0.0.1",
      "listen_port": 8787,
      "credential_env": "",
      "credential_header": "",
      "credential_prefix": "",
      "control_token_env": "SYNTAVRA_PROXY_CONTROL_TOKEN",
      "allow_remote": false,
      "allow_insecure_upstream": false,
      "tls_cert_file": "",
      "tls_key_file": "",
      "cache_policy": "auto",
      "replay_ttl_seconds": 900,
      "prompt_cache_ttl_seconds": 300,
      "timeout_seconds": 180.0,
      "max_request_bytes": 16777216,
      "max_buffered_response_bytes": 67108864,
      "spool_memory_bytes": 2097152,
      "default_anthropic_version": "2023-06-01",
      "stream_mode": "commit-before-forward",
      "max_concurrent_requests": 64,
      "drain_timeout_seconds": 30.0,
      "block_secret_outputs": true,
      "block_prompt_injection_outputs": true
    }
  },
  "transport": {
    "retry_policy": "no-automatic-retry",
    "upstream_attempts_per_request": 1,
    "timeout_error_status": 502,
    "transport_error_detail": "upstream request failed",
    "upstream_http_status_policy": "preserve-status-and-body-after-evidence-commit",
    "stream_mode": "commit-before-forward",
    "control_unauthorized_status": 401,
    "control_unauthorized_error": "invalid-control-token"
  }
}
