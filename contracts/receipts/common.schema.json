{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntavra.dev/contracts/receipts/common.schema.json",
  "title": "Syntavra Common Receipt Fields",
  "type": "object",
  "required": [
    "schema_version",
    "product_version",
    "contract_version",
    "engine",
    "operation",
    "created_at",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "product_version": {"type": "string"},
    "contract_version": {"type": "integer", "minimum": 1},
    "engine": {"enum": ["python", "rust"]},
    "operation": {"type": "string", "minLength": 1},
    "created_at": {"type": "number"},
    "project_id": {"type": "string"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "fallback": {
      "type": ["object", "null"],
      "properties": {
        "from": {"enum": ["python", "rust"]},
        "to": {"enum": ["python", "rust"]},
        "reason": {"type": "string"},
        "state_mutated": {"const": false}
      },
      "required": ["from", "to", "reason", "state_mutated"],
      "additionalProperties": false
    }
  }
}
