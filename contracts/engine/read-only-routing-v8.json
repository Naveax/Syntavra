      "accepted_input_profiles": ["project-bound-receipt-wire-v1"],
      "input_format": "R7RCPT1-lowercase-hex-v1",
      "rust_argv": {
        "project-bound-receipt-wire-v1": [
          "receipt",
          "inspect",
          "<derived-project-id>",
          "<canonical-receipt-wire-hex>"
        ]
      }
    },
    {
      "command": "state.inspect",
