fn cc_json_token_boundary(bytes:&[u8],end:usize)->bool{bytes.get(end).map_or(true,|b|!b.is_ascii_alphanumeric()&&*b!=b'_')}
fn cc_python_json_compat(text:&str)->String{let b=text.as_bytes();let mut o=Vec::with_capacity(b.len());let(mut i,mut q,mut e)=(0,false,false);while i<b.len(){let c=b[i];if q{o.push(c);if e{e=false}else if c==b'\\'{e=true}else if c==b'"'{q=false}i+=1;continue}if c==b'"'{q=true;o.push(c);i+=1;continue}let r=&b[i..];if r.starts_with(b"-Infinity")&&cc_json_token_boundary(b,i+9){o.extend_from_slice(b"true");i+=9;continue}if r.starts_with(b"Infinity")&&cc_json_token_boundary(b,i+8){o.extend_from_slice(b"true");i+=8;continue}if r.starts_with(b"NaN")&&cc_json_token_boundary(b,i+3){o.extend_from_slice(b"true");i+=3;continue}o.push(c);i+=1}String::from_utf8(o).unwrap_or_else(|_|text.to_owned())}
fn cc_parse_python_json(text:&str)->Result<Value,serde_json::Error>{serde_json::from_str(&cc_python_json_compat(text))}
fn cc_load_transcript_compat(text:&str)->Vec<Value>{if let Ok(v)=cc_parse_python_json(text){if let Some(rows)=v.as_array(){return rows.iter().filter(|r|r.is_object()).cloned().collect()}if let Some(obj)=v.as_object(){let selected=["events","messages","transcript"].iter().filter_map(|k|obj.get(*k)).find(|v|cc_json_truthy(v));if let Some(rows)=selected.and_then(Value::as_array){return rows.iter().filter(|r|r.is_object()).cloned().collect()}return Vec::new()}return Vec::new()}text.lines().filter_map(|l|cc_parse_python_json(l).ok()).filter(Value::is_object).collect()}

const CC_JSON_NAN:&str="__SYNTAVRA_CC_NAN__";const CC_JSON_INF:&str="__SYNTAVRA_CC_INF__";const CC_JSON_NINF:&str="__SYNTAVRA_CC_NINF__";const CC_JSON_INT:&str="__SYNTAVRA_CC_INT__";
fn cc_push_json_marker(o:&mut Vec<u8>,m:&str){o.push(b'"');o.extend_from_slice(m.as_bytes());o.push(b'"')}
fn cc_json_number_delimiter(b:u8)->bool{matches!(b,b','|b']'|b'}'|b' '|b'\t'|b'\r'|b'\n')}
fn cc_compactor_json_compat(text:&str)->String{let b=text.as_bytes();let mut o=Vec::with_capacity(b.len()+64);let(mut i,mut q,mut e)=(0,false,false);while i<b.len(){let c=b[i];if q{o.push(c);if e{e=false}else if c==b'\\'{e=true}else if c==b'"'{q=false}i+=1;continue}if c==b'"'{q=true;o.push(c);i+=1;continue}let r=&b[i..];if r.starts_with(b"-Infinity")&&cc_json_token_boundary(b,i+9){cc_push_json_marker(&mut o,CC_JSON_NINF);i+=9;continue}if r.starts_with(b"Infinity")&&cc_json_token_boundary(b,i+8){cc_push_json_marker(&mut o,CC_JSON_INF);i+=8;continue}if r.starts_with(b"NaN")&&cc_json_token_boundary(b,i+3){cc_push_json_marker(&mut o,CC_JSON_NAN);i+=3;continue}let numeric=c.is_ascii_digit()||(c==b'-'&&b.get(i+1).is_some_and(u8::is_ascii_digit));if numeric{let s=i;i+=1;while i<b.len()&&!cc_json_number_delimiter(b[i]){i+=1}let t=std::str::from_utf8(&b[s..i]).unwrap_or("");if t=="-0"{o.push(b'0');continue}let integer=!t.contains(['.','e','E']);if integer&&t.parse::<i64>().is_err()&&t.parse::<u64>().is_err(){cc_push_json_marker(&mut o,&format!("{CC_JSON_INT}{t}"));continue}if !integer{if let Ok(n)=t.parse::<f64>(){if n.is_infinite(){cc_push_json_marker(&mut o,if n.is_sign_negative(){CC_JSON_NINF}else{CC_JSON_INF});continue}}}o.extend_from_slice(&b[s..i]);continue}o.push(c);i+=1}String::from_utf8(o).unwrap_or_else(|_|text.to_owned())}
fn cc_shrink_json(v:&Value)->Value{match v{Value::Object(m)=>{let mut keys=m.keys().collect::<Vec<_>>();keys.sort_by(|a,b|a.to_string().cmp(&b.to_string()));let mut r=serde_json::Map::new();for k in keys.iter().take(30){r.insert((*k).clone(),cc_shrink_json(&m[*k]));}if keys.len()>30{r.insert("<omitted_keys>".to_owned(),Value::from(keys.len()-30));}Value::Object(r)}Value::Array(a) if a.len()<=10=>Value::Array(a.iter().map(cc_shrink_json).collect()),Value::Array(a)=>{let mut r=serde_json::Map::new();r.insert("length".to_owned(),Value::from(a.len()));r.insert("head".to_owned(),Value::Array(a.iter().take(6).map(cc_shrink_json).collect()));r.insert("tail".to_owned(),Value::Array(a.iter().skip(a.len().saturating_sub(2)).map(cc_shrink_json).collect()));Value::Object(r)}Value::String(s) if s.chars().count()>300=>{let n=s.chars().count();Value::String(format!("{}…<{n} chars>…{}",s.chars().take(180).collect::<String>(),s.chars().skip(n.saturating_sub(60)).collect::<String>()))}_=>v.clone()}}
fn cc_restore_python_json_literals(s:String)->Result<String,String>{let s=s.replace(&format!("\"{CC_JSON_NAN}\""),"NaN").replace(&format!("\"{CC_JSON_INF}\""),"Infinity").replace(&format!("\"{CC_JSON_NINF}\""),"-Infinity");let re=regex::Regex::new(&format!(r#"\"{}(-?[0-9]+)\""#,CC_JSON_INT)).map_err(|e|format!("COMPACTOR_BIGINT_REGEX_FAILED:{e}"))?;Ok(re.replace_all(&s,"$1").into_owned())}
fn cc_json_or_table_compact(output:&str)->Result<Option<String>,String>{let prepared=cc_compactor_json_compat(output);let Ok(v)=serde_json::from_str::<Value>(&prepared) else{return Ok(None)};let rendered=serde_json::to_string_pretty(&cc_sort_json(&cc_shrink_json(&v))).map_err(|e|format!("COMPACTOR_JSON_RENDER_FAILED:{e}"))?;cc_restore_python_json_literals(rendered).map(Some)}
fn cc_compact_compat(command:&str,output:&str)->Result<Option<(&'static str,String)>,String>{Ok(cc_compact(command,output))}

fn cc_transcript_mine_compat(arguments:&[String])->Result<Value,String>{let start=arguments.windows(2).position(|x|x[0]=="run"&&x[1]=="transcript-mine").map(|i|i+2).ok_or_else(||"ACTION_NOT_FOUND:transcript-mine".to_owned())?;let source=arguments.get(start).ok_or_else(||"POSITIONAL_MISSING:transcript-mine:0".to_owned())?;let text=if Path::new(source).is_file(){fs::read_to_string(source).map_err(|e|format!("TRANSCRIPT_READ_FAILED:{e}"))?}else{source.to_owned()};let events=cc_load_transcript_compat(&text);let mut ops=Vec::<Value>::new();let mut commands=0usize;for(index,row)in events.iter().enumerate(){let command=cc_transcript_command(row);if command.is_empty(){continue}commands+=1;let output=cc_transcript_output(row);let input=((command.as_bytes().len()+output.as_bytes().len())/4).max(1);let rewrite=cc_rewrite_text(&command)?;if rewrite["changed"].as_bool().unwrap_or(false){ops.push(serde_json::json!({"index":index,"command":command,"kind":"pre-tool-rewrite","estimated_input_tokens":input,"estimated_saved_tokens":(output.chars().count()/20).max(8),"recommendation":"rewrite before execution","rule":rewrite["rule"],"compactor":Value::Null}));}if let Some((compactor,visible))=cc_compact_compat(&command,&output)?{let saved=output.as_bytes().len().saturating_sub(visible.as_bytes().len())/4;if saved>0{ops.push(serde_json::json!({"index":index,"command":command,"kind":"post-tool-compaction","estimated_input_tokens":input,"estimated_saved_tokens":saved,"recommendation":"capture exact output and return compact view","rule":Value::Null,"compactor":compactor}));}}}let total=ops.iter().map(|r|r["estimated_saved_tokens"].as_u64().unwrap_or(0)).sum::<u64>();let mut body=serde_json::json!({"events":events.len(),"commands":commands,"opportunities":ops,"estimated_saved_tokens":total,"coverage":{"rewrite_rules":REWRITE_RULE_COUNT,"compactors":COMPACTOR_COUNT}});body["analysis_hash"]=Value::String(syntavra_core::sha256_hex(cc_canonical_json(&body)?.as_bytes()));Ok(body)}

fn cc_stateful_roots(arguments:&[String])->Result<(std::path::PathBuf,std::path::PathBuf),String>{let project=arguments.iter().position(|x|x=="--project").and_then(|i|arguments.get(i+1)).ok_or_else(||"PROJECT_ARGUMENT_MISSING".to_owned())?;let state=arguments.iter().position(|x|x=="--state-root").and_then(|i|arguments.get(i+1)).ok_or_else(||"STATE_ROOT_ARGUMENT_MISSING".to_owned())?;let project=std::path::PathBuf::from(project).canonicalize().map_err(|e|format!("PROJECT_RESOLVE_FAILED:{e}"))?;let state=std::path::PathBuf::from(state);fs::create_dir_all(&state).map_err(|e|format!("STATE_ROOT_CREATE_FAILED:{e}"))?;Ok((project,state))}
fn cc_checkpoint_supports(command:&[String])->bool{matches!(command,[root,action] if root=="run"&&matches!(action.as_str(),"rewrite"|"transcript-mine"|"watch"|"worker"))}
fn cc_checkpoint_execute(command:&[String],arguments:&[String])->Result<Option<Value>,String>{if !cc_checkpoint_supports(command){return Ok(None)}match command[1].as_str(){"rewrite"=>cc_rewrite_action(arguments).map(Some),"transcript-mine"=>cc_transcript_mine_compat(arguments).map(Some),"watch"=>{let(p,s)=cc_stateful_roots(arguments)?;cc_watch_action(arguments,&p,&s).map(Some)},"worker"=>{let(p,s)=cc_stateful_roots(arguments)?;cc_worker_action(arguments,&p,&s).map(Some)},_=>Ok(None)}}
