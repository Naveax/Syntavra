const CC_NAN:&str="__SYN_NAN__";const CC_INF:&str="__SYN_INF__";const CC_NINF:&str="__SYN_NINF__";const CC_INT:&str="__SYN_INT__";
fn cc_boundary(b:&[u8],i:usize)->bool{b.get(i).map_or(true,|x|!x.is_ascii_alphanumeric()&&*x!=b'_')}
fn cc_marker(o:&mut Vec<u8>,m:&str){o.push(b'"');o.extend_from_slice(m.as_bytes());o.push(b'"')}
fn cc_json_scan(text:&str,markers:bool)->String{
 let b=text.as_bytes();let mut o=Vec::with_capacity(b.len()+32);let(mut i,mut q,mut e)=(0,false,false);
 while i<b.len(){let c=b[i];if q{o.push(c);if e{e=false}else if c==b'\\'{e=true}else if c==b'"'{q=false}i+=1;continue}if c==b'"'{q=true;o.push(c);i+=1;continue}let r=&b[i..];
  let hit=if r.starts_with(b"-Infinity")&&cc_boundary(b,i+9){Some((9,CC_NINF))}else if r.starts_with(b"Infinity")&&cc_boundary(b,i+8){Some((8,CC_INF))}else if r.starts_with(b"NaN")&&cc_boundary(b,i+3){Some((3,CC_NAN))}else{None};
  if let Some((n,m))=hit{if markers{cc_marker(&mut o,m)}else{o.extend_from_slice(b"true")}i+=n;continue}
  if markers&&(c.is_ascii_digit()||(c==b'-'&&b.get(i+1).is_some_and(u8::is_ascii_digit))){let s=i;i+=1;while i<b.len()&&!matches!(b[i],b','|b']'|b'}'|b' '|b'\t'|b'\r'|b'\n'){i+=1}let t=std::str::from_utf8(&b[s..i]).unwrap_or("");if t=="-0"{o.push(b'0');continue}let integer=!t.contains(['.','e','E']);if integer&&t.parse::<i64>().is_err()&&t.parse::<u64>().is_err(){cc_marker(&mut o,&format!("{CC_INT}{t}"));continue}if !integer&&t.parse::<f64>().ok().is_some_and(f64::is_infinite){cc_marker(&mut o,if t.starts_with('-'){CC_NINF}else{CC_INF});continue}o.extend_from_slice(&b[s..i]);continue}
  o.push(c);i+=1}
 String::from_utf8(o).unwrap_or_else(|_|text.to_owned())
}
fn cc_parse_python_json(text:&str)->Result<Value,serde_json::Error>{serde_json::from_str(&cc_json_scan(text,false))}
fn cc_load_transcript_compat(text:&str)->Vec<Value>{if let Ok(v)=cc_parse_python_json(text){if let Some(a)=v.as_array(){return a.iter().filter(|x|x.is_object()).cloned().collect()}if let Some(o)=v.as_object(){let x=["events","messages","transcript"].iter().filter_map(|k|o.get(*k)).find(|v|cc_json_truthy(v));return x.and_then(Value::as_array).map_or_else(Vec::new,|a|a.iter().filter(|x|x.is_object()).cloned().collect())}return Vec::new()}text.lines().filter_map(|x|cc_parse_python_json(x).ok()).filter(Value::is_object).collect()}
fn cc_shrink_json(v:&Value)->Value{match v{Value::Object(m)=>{let mut k=m.keys().collect::<Vec<_>>();k.sort();let mut o=serde_json::Map::new();for x in k.iter().take(30){o.insert((*x).clone(),cc_shrink_json(&m[*x]));}if k.len()>30{o.insert("<omitted_keys>".into(),Value::from(k.len()-30));}Value::Object(o)}Value::Array(a)if a.len()>10=>serde_json::json!({"length":a.len(),"head":a.iter().take(6).map(cc_shrink_json).collect::<Vec<_>>(),"tail":a.iter().skip(a.len()-2).map(cc_shrink_json).collect::<Vec<_>>()}) ,Value::Array(a)=>Value::Array(a.iter().map(cc_shrink_json).collect()),Value::String(s)if s.chars().count()>300=>{let n=s.chars().count();Value::String(format!("{}…<{n} chars>…{}",s.chars().take(180).collect::<String>(),s.chars().skip(n-60).collect::<String>()))}_=>v.clone()}}
fn cc_restore(s:String)->Result<String,String>{let s=s.replace(&format!("\"{CC_NAN}\""),"NaN").replace(&format!("\"{CC_INF}\""),"Infinity").replace(&format!("\"{CC_NINF}\""),"-Infinity");let r=regex::Regex::new(&format!(r#"\"{}(-?[0-9]+)\""#,CC_INT)).map_err(|e|format!("COMPACTOR_BIGINT_REGEX_FAILED:{e}"))?;Ok(r.replace_all(&s,"$1").into_owned())}
fn cc_json_or_table_compact(output:&str)->Result<Option<String>,String>{let Ok(v)=serde_json::from_str::<Value>(&cc_json_scan(output,true))else{return Ok(None)};let s=serde_json::to_string_pretty(&cc_sort_json(&cc_shrink_json(&v))).map_err(|e|format!("COMPACTOR_JSON_RENDER_FAILED:{e}"))?;cc_restore(s).map(Some)}
fn cc_transcript_mine_compat(arguments:&[String])->Result<Value,String>{let s=arguments.windows(2).position(|x|x[0]=="run"&&x[1]=="transcript-mine").map(|i|i+2).ok_or_else(||"ACTION_NOT_FOUND:transcript-mine".to_owned())?;let src=arguments.get(s).ok_or_else(||"POSITIONAL_MISSING:transcript-mine:0".to_owned())?;let text=if Path::new(src).is_file(){fs::read_to_string(src).map_err(|e|format!("TRANSCRIPT_READ_FAILED:{e}"))?}else{src.clone()};let events=cc_load_transcript_compat(&text);let mut ops=Vec::<Value>::new();let mut commands=0;for(i,row)in events.iter().enumerate(){let command=cc_transcript_command(row);if command.is_empty(){continue}commands+=1;let output=cc_transcript_output(row);let input=((command.len()+output.len())/4).max(1);let rw=cc_rewrite_text(&command)?;if rw["changed"].as_bool().unwrap_or(false){ops.push(serde_json::json!({"index":i,"command":command,"kind":"pre-tool-rewrite","estimated_input_tokens":input,"estimated_saved_tokens":(output.chars().count()/20).max(8),"recommendation":"rewrite before execution","rule":rw["rule"],"compactor":Value::Null}));}if let Some((c,visible))=cc_compact(&command,&output){let saved=output.len().saturating_sub(visible.len())/4;if saved>0{ops.push(serde_json::json!({"index":i,"command":command,"kind":"post-tool-compaction","estimated_input_tokens":input,"estimated_saved_tokens":saved,"recommendation":"capture exact output and return compact view","rule":Value::Null,"compactor":c}));}}}let total=ops.iter().map(|x|x["estimated_saved_tokens"].as_u64().unwrap_or(0)).sum::<u64>();let mut body=serde_json::json!({"events":events.len(),"commands":commands,"opportunities":ops,"estimated_saved_tokens":total,"coverage":{"rewrite_rules":REWRITE_RULE_COUNT,"compactors":COMPACTOR_COUNT}});body["analysis_hash"]=Value::String(syntavra_core::sha256_hex(cc_canonical_json(&body)?.as_bytes()));Ok(body)}
fn cc_roots(a:&[String])->Result<(std::path::PathBuf,std::path::PathBuf),String>{let p=a.iter().position(|x|x=="--project").and_then(|i|a.get(i+1)).ok_or_else(||"PROJECT_ARGUMENT_MISSING".to_owned())?;let s=a.iter().position(|x|x=="--state-root").and_then(|i|a.get(i+1)).ok_or_else(||"STATE_ROOT_ARGUMENT_MISSING".to_owned())?;let p=std::path::PathBuf::from(p).canonicalize().map_err(|e|format!("PROJECT_RESOLVE_FAILED:{e}"))?;let s=std::path::PathBuf::from(s);fs::create_dir_all(&s).map_err(|e|format!("STATE_ROOT_CREATE_FAILED:{e}"))?;Ok((p,s))}
fn cc_checkpoint_supports(c:&[String])->bool{matches!(c,[r,a]if r=="run"&&matches!(a.as_str(),"rewrite"|"transcript-mine"|"watch"|"worker"|"provider-pool"|"code-intel"|"dashboard"))}
fn cc_checkpoint_execute(c:&[String],a:&[String])->Result<Option<Value>,String>{if !cc_checkpoint_supports(c){return Ok(None)}match c[1].as_str(){"rewrite"=>cc_rewrite_action(a).map(Some),"transcript-mine"=>cc_transcript_mine_compat(a).map(Some),"watch"=>{let(p,s)=cc_roots(a)?;cc_watch_action(a,&p,&s).map(Some)},"worker"=>{let(p,s)=cc_roots(a)?;cc_worker_action(a,&p,&s).map(Some)},"provider-pool"=>{let(p,s)=cc_roots(a)?;let i=cc_stateful_action_index(a,"provider-pool").ok_or_else(||"ACTION_NOT_FOUND:provider-pool".to_owned())?;if a.get(i).map(String::as_str)==Some("route"){cc_pool_route_action(a,&p,&s).map(Some)}else{native_remaining71_competitive::execute(c,a,&p,&s)}},"code-intel"=>{let(p,s)=cc_roots(a)?;let i=cc_stateful_action_index(a,"code-intel").ok_or_else(||"ACTION_NOT_FOUND:code-intel".to_owned())?;if a.get(i).map(String::as_str)==Some("report"){cc_code_intel_report(&p,&s).map(Some)}else{native_remaining71_competitive::execute(c,a,&p,&s)}},"dashboard"=>{let(p,s)=cc_roots(a)?;if a.iter().any(|x|x=="--snapshot"){cc_dashboard_snapshot(&p,&s).map(Some)}else{native_remaining71_competitive::execute(c,a,&p,&s)}},_=>Ok(None)}}
