{
  "schema_version": 1,
  "remove_fields": [
    "created_at",
    "updated_at",
    "loaded_at",
    "duration_ms",
    "wall_time_ms",
    "pid",
    "job_id",
    "transaction_id",
    "temporary_path"
  ],
  "path_fields": [
    "path",
    "root",
    "project",
    "project_root",
    "state_root",
    "backup_path",
    "output"
  ],
  "path_replacements": {
    "<PROJECT>": "resolved project root",
    "<HOME>": "resolved user home",
    "<TEMP>": "resolved temporary root"
  },
  "forbidden_normalization": [
    "exit_code",
    "ok",
    "state",
    "error.code",
    "receipt_hash",
    "contract_hash",
    "schema_version"
  ]
}
